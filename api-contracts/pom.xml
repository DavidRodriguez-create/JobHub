<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.davidcreate.jobhub</groupId>
    <artifactId>jobhub-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>api-contracts</artifactId>
  <packaging>jar</packaging>
  <description>
    OpenAPI 3.0 contracts for all JobHub services.
    This module is the single source of truth for every service's API surface.
    The YAML files under src/main/resources/openapi/ are packaged into the JAR,
    and compiled JAX-RS interfaces + model classes are generated from them so
    services can implement/depend on this artifact directly.

    Each spec uses x-implementation-status on operations and schema properties:
      existing — already implemented in the service
      planned  — needed to fully wire the UI (see JobHub-ui/BACKEND_GAPS.md)
  </description>

  <!--
    Compile-time stubs only — JAX-RS, Validation, and Jackson are provided
    by Quarkus in every service that depends on this artifact.
  -->
  <dependencies>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.10.0</version>
        <executions>

          <!-- ── Auth Service ───────────────────────────────────────────── -->
          <execution>
            <id>generate-auth-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/auth-service.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/auth-api</output>
              <apiPackage>com.davidcreate.jobhub.auth.contract.api</apiPackage>
              <modelPackage>com.davidcreate.jobhub.auth.contract.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useJakartaEe>true</useJakartaEe>
                <returnResponse>true</returnResponse>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>true</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Application Service ───────────────────────────────────── -->
          <execution>
            <id>generate-application-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/application-service.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/application-api</output>
              <apiPackage>com.davidcreate.jobhub.application.contract.api</apiPackage>
              <modelPackage>com.davidcreate.jobhub.application.contract.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useJakartaEe>true</useJakartaEe>
                <returnResponse>true</returnResponse>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>true</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Ollama (external API we consume) ──────────────────────── -->
          <execution>
            <id>generate-ollama-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/ollama.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/ollama-api</output>
              <apiPackage>com.davidcreate.jobhub.ollama.contract.api</apiPackage>
              <modelPackage>com.davidcreate.jobhub.ollama.contract.model</modelPackage>
              <!-- Ollama is an external API we consume. Generate an interface-only
                   JAX-RS API (named from the `Chat` tag → ChatApi) plus models; the
                   consuming service's @RegisterRestClient interface extends ChatApi.
                   The method returns the model directly (returnResponse=false) so the
                   rest-client signature is ChatResponse chat(ChatRequest). -->
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <returnResponse>false</returnResponse>
                <useTags>true</useTags>
                <useJakartaEe>true</useJakartaEe>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>false</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Gemini (external API we consume) ──────────────────────── -->
          <execution>
            <id>generate-gemini-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/gemini.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/gemini-api</output>
              <modelPackage>com.davidcreate.jobhub.gemini.contract.model</modelPackage>
              <!-- Models only. The path carries a literal ":generateContent" suffix
                   and an x-goog-api-key header; the consuming service declares the
                   @RegisterRestClient method in-module (GeminiClient) referencing
                   these models, so no API interface is generated here. -->
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <returnResponse>false</returnResponse>
                <useJakartaEe>true</useJakartaEe>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>false</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── OpenAI-compatible (external API we consume) ───────────── -->
          <execution>
            <id>generate-openai-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/openai.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/openai-api</output>
              <modelPackage>com.davidcreate.jobhub.openai.contract.model</modelPackage>
              <!-- Models only. The consuming service declares the @RegisterRestClient-free
                   OpenAiClient interface in-module referencing these models, so no API
                   interface is generated here. -->
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <returnResponse>false</returnResponse>
                <useJakartaEe>true</useJakartaEe>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>false</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Google OAuth (external API we consume) ────────────────── -->
          <execution>
            <id>generate-google-oauth-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/google-oauth.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/google-oauth-api</output>
              <modelPackage>com.davidcreate.jobhub.google.contract.model</modelPackage>
              <!-- Models only. The token endpoint is form-encoded and the userinfo endpoint
                   lives on a different host than the token endpoint, so auth-service
                   declares its own @RegisterRestClient interfaces (GoogleTokenClient,
                   GoogleUserInfoClient) in-module referencing these models. -->
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <returnResponse>false</returnResponse>
                <useJakartaEe>true</useJakartaEe>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>false</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── GitHub OAuth (external API we consume) ────────────────── -->
          <execution>
            <id>generate-github-oauth-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/github-oauth.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/github-oauth-api</output>
              <modelPackage>com.davidcreate.jobhub.github.contract.model</modelPackage>
              <!-- Models only. The token endpoint (github.com) lives on a different host
                   than the REST API (api.github.com), so auth-service declares its own
                   @RegisterRestClient interfaces (GithubTokenClient, GithubApiClient)
                   in-module referencing these models. -->
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <returnResponse>false</returnResponse>
                <useJakartaEe>true</useJakartaEe>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>false</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Notification Service ─────────────────────────────────── -->
          <execution>
            <id>generate-notification-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/notification-service.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/notification-api</output>
              <apiPackage>com.davidcreate.jobhub.notification.contract.api</apiPackage>
              <modelPackage>com.davidcreate.jobhub.notification.contract.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useJakartaEe>true</useJakartaEe>
                <returnResponse>true</returnResponse>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>true</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Job Service ───────────────────────────────────────────── -->
          <execution>
            <id>generate-job-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/job-service.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/job-api</output>
              <apiPackage>com.davidcreate.jobhub.job.contract.api</apiPackage>
              <modelPackage>com.davidcreate.jobhub.job.contract.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useJakartaEe>true</useJakartaEe>
                <returnResponse>true</returnResponse>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>true</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

          <!-- ── Crawler Service ───────────────────────────────────────── -->
          <execution>
            <id>generate-crawler-api</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/crawler-service.yaml</inputSpec>
              <generatorName>jaxrs-spec</generatorName>
              <output>${project.build.directory}/generated-sources/crawler-api</output>
              <apiPackage>com.davidcreate.jobhub.crawler.contract.api</apiPackage>
              <modelPackage>com.davidcreate.jobhub.crawler.contract.model</modelPackage>
              <!-- Internal-only surface (ADR 0033). Generated exactly like the other JobHub
                   service specs: interfaces + models. crawler-service implements the
                   generated interface in adapter/in/rest; job-service declares its own
                   @RegisterRestClient interface in-module referencing these models, since
                   a rest-client cannot inherit JAX-RS methods from a non-indexed jar. -->
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useJakartaEe>true</useJakartaEe>
                <returnResponse>true</returnResponse>
                <serializationLibrary>jackson</serializationLibrary>
                <useBeanValidation>true</useBeanValidation>
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <dateLibrary>java8</dateLibrary>
                <sourceFolder>.</sourceFolder>
              </configOptions>
            </configuration>
          </execution>

        </executions>
      </plugin>
    </plugins>
  </build>

</project>
