# JobHub environment variables template
# Copy this file to .env and fill in your local values
# DO NOT commit .env to git — it contains credentials
#
# Security: Each service has its own database user with access to only its schema
# This follows the principle of least privilege

# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────

# Crawler Service (crawler schema)
CRAWLER_DATABASE_URL=jdbc:postgresql://db:5432/jobhub
CRAWLER_DATABASE_USERNAME=crawler_user
CRAWLER_DATABASE_PASSWORD=crawler_password

# LLM enrichment toggle — set to false on hosts without an Ollama/LLM backend.
# When false the enrichment scheduler no-ops; no model calls are made.
CRAWLER_ENRICHMENT_ENABLED=true

# Ollama provider toggle (ADR 0004) — DISABLED BY DEFAULT. The local Ollama
# fallback provider (crawler.enrichment.providers[1]) is only used when this is
# "true" AND the ollama container is started via the opt-in compose profile:
#   podman compose --profile ollama up -d
CRAWLER_OLLAMA_ENABLED=false

# Admin crawl/enrichment trigger (Story #7 / ADR 0003).
# How often TriggerRequestScheduler polls crawler.trigger_request for queued rows
# written by job-service's admin endpoints. Default: every 10 seconds.
CRAWLER_TRIGGER_POLL_CRON=0/10 * * * * ?

# Job Service (job schema)
JOB_DATABASE_URL=jdbc:postgresql://db:5432/jobhub
JOB_DATABASE_USERNAME=job_user
JOB_DATABASE_PASSWORD=job_password

# Admin crawl/enrichment trigger (Story #7 / ADR 0003; 2FA gate: ADR 0019).
# Toggle the admin endpoints (POST /jobs/admin/triggers) on/off without a rebuild —
# change the value and `podman compose up -d job-service` to apply.
JOBHUB_ADMIN_TRIGGER_ENABLED=true
# The emailed-code gate (JOBHUB_ADMIN_TRIGGER_REQUIRE_CODE) was removed by ADR 0019:
# security is now delegated to the triggering admin's own 2FA (see AUTH_SERVICE_URL /
# JOBHUB_INTERNAL_SERVICE_KEY below).

# Auth Service (auth schema)
AUTH_DATABASE_URL=jdbc:postgresql://db:5432/jobhub
AUTH_DATABASE_USERNAME=auth_user
AUTH_DATABASE_PASSWORD=auth_password

# Admin allowlist (ADR 0003): comma-separated emails (case-insensitive) authorised to
# call the crawl/enrichment admin trigger endpoints. Empty = no admins. Restart
# (container recreate) to pick up changes — see deploy/providers/oci-free/README.md.
AUTH_ADMIN_EMAILS=

# Pre-shared API key for service-to-service calls to auth-service's /internal/*
# endpoints (ADR 0008, ticket #100), e.g. notification-service resolving emails for
# the weekly digest. Must match across every service that calls these endpoints.
JOBHUB_INTERNAL_SERVICE_KEY=dev-internal-service-key

# job-service -> auth-service outbound REST client (admin-trigger 2FA gate, ADR 0019:
# reads/verifies the triggering admin's own 2FA status/code). On the compose network,
# auth-service is reachable at this URL. Guarded on the auth-service side by
# JOBHUB_INTERNAL_SERVICE_KEY (X-Service-Key) below, which must match.
AUTH_SERVICE_URL=http://auth-service:8082

# AES-256-GCM key (ADR 0012) used to encrypt TOTP secrets at rest in auth.totp_secret.
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# Rotate via a future key-rotation ADR; changing this value invalidates all stored
# 2FA secrets (users would need to re-enroll).
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Application Service (applications schema)
APPLICATIONS_DATABASE_URL=jdbc:postgresql://db:5432/jobhub
APPLICATIONS_DATABASE_USERNAME=applications_user
APPLICATIONS_DATABASE_PASSWORD=applications_password

# Notification Service (notification schema)
NOTIFICATION_DATABASE_URL=jdbc:postgresql://db:5432/jobhub
NOTIFICATION_DATABASE_USERNAME=notification_user
NOTIFICATION_DATABASE_PASSWORD=notification_password

# Notification Service — SMTP for digest/interview-reminder/ghosted-alert emails
# (Story #80 / ADR 0008, story #209). Real sending is the DEFAULT
# (NOTIFICATION_MAILER_MOCK=false): fill in a real HOST/USERNAME/PASSWORD/FROM below and the
# service sends genuine email. If those are blank/wrong the send FAILS LOUDLY (ERROR in the
# logs) - it does not silently mock. Set NOTIFICATION_MAILER_MOCK=true only if you explicitly
# want emails logged-but-not-sent (e.g. a throwaway smoke run).
#   Gmail example: HOST=smtp.gmail.com PORT=587 START_TLS=REQUIRED, USERNAME=<addr>,
#   PASSWORD=<16-char app password> (not your account password).
#   Local catcher (no real provider): podman compose --profile mailpit up -d mailpit, then
#   HOST=mailpit PORT=1025 START_TLS=DISABLED and browse http://localhost:8025
NOTIFICATION_MAILER_MOCK=false
NOTIFICATION_MAILER_FROM=digest@jobhub.local
NOTIFICATION_MAILER_HOST=
NOTIFICATION_MAILER_PORT=587
NOTIFICATION_MAILER_USERNAME=
NOTIFICATION_MAILER_PASSWORD=
NOTIFICATION_MAILER_START_TLS=REQUIRED

# Admin user (for migrations, maintenance)
ADMIN_DATABASE_URL=jdbc:postgresql://db:5432/jobhub
ADMIN_DATABASE_USERNAME=jobhub_admin
ADMIN_DATABASE_PASSWORD=jobhub_admin_password

# Gemini provider (crawler.enrichment.providers[0]) — leave blank to skip Gemini
# and fall through to the next enabled provider in the chain.
GEMINI_API_KEY=

# DeepSeek (or any OpenAI-compatible provider) — example of an additional indexed
# provider entry (see crawler-service/src/main/resources/application.properties
# for the matching crawler.enrichment.providers[2].* config). Uncomment and set
# both to enable.
# DEEPSEEK_API_KEY=

# Auth Service — email notifications (Story #6 / DevOps #26)
# prod SMTP — set per deployment; no creds committed; dev/test use the mock notifier
# (LoggingVerificationNotifier is active when quarkus.mailer.mock=true or in %dev).
# In production supply real SMTP values via the secrets manager / .env on the host.
MAILER_FROM=
MAILER_HOST=
MAILER_PORT=
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_START_TLS=

# ─── PRODUCTION (example) ───────────────────────────────────────────────────

# Production: Use a secrets manager (Vault, AWS Secrets Manager, etc.)
# NEVER commit real credentials to git
#
# Example for production:
# CRAWLER_DATABASE_URL=jdbc:postgresql://prod-db.example.com:5432/jobhub-prod
# CRAWLER_DATABASE_USERNAME=<from-vault>
# CRAWLER_DATABASE_PASSWORD=<from-vault>
#
# JOB_DATABASE_URL=jdbc:postgresql://prod-db.example.com:5432/jobhub-prod
# JOB_DATABASE_USERNAME=<from-vault>
# JOB_DATABASE_PASSWORD=<from-vault>
#
# GEMINI_API_KEY=<from-vault>
#
# ... (same pattern for auth and applications services)

# ----------------------------------------------------------------------------
# Social login OAuth (ADR 0027, story #459)
# Leave a provider's client id/secret empty to keep it disabled: its
# GET /oauth/{provider}/start returns 404 until configured.
# Google: create an OAuth 2.0 Client (type Web application) in Google Cloud
#   Console; authorised redirect URI = <UI origin>/oauth/google/callback.
# GitHub: register a GitHub OAuth App; Authorization callback URL =
#   <UI origin>/oauth/github/callback.
# ----------------------------------------------------------------------------
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
